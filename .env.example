# Module secrets only. On the appliance these are edited in Preferences → Chaavi, which writes
# modules/chaavi/.env and restarts Chaavi; in compose they live in chaavi/.env.
#
# The vault account Chaavi unlocks for the agents. Empty is fine: Chaavi boots either way and
# the first /v1 call names the first empty variable (503 vault_unconfigured).
#
# CHAAVI_EMAIL may stay empty while the vault has exactly one account; Chaavi uses that one.
# An older BW_PASSWORD still stands in for an empty CHAAVI_PASSWORD.

CHAAVI_EMAIL=
CHAAVI_PASSWORD=

# Set on the container by Nas (compose environment / quadlet Environment), not in this file:
# DOMAIN=https://chaavi.dadi
# SIGNUPS_ALLOWED=true
# ROCKET_PORT=8080
# EXPERIMENTAL_CLIENT_FEATURE_FLAGS=pm-32009-new-item-types
