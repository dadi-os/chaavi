# Module secrets only (BW_*). Nas injects VAULT_URL and
# BITWARDENCLI_APPDATA_DIR on the container — do not put those in this file
# for compose/prod. Local one-off runs may export them in the shell.

# Personal API key + master password. Empty means the vault is unconfigured:
# the process boots, GET /health reports vault=unconfigured, and /v1/*
# returns 503 vault_unconfigured. All three must be set together, or all empty.

BW_CLIENTID=
BW_CLIENTSECRET=
BW_PASSWORD=

# Injected by Nas (compose environment / quadlet Environment), not this file:
# VAULT_URL=http://chaavi-vault:80
# BITWARDENCLI_APPDATA_DIR=/var/lib/chaavi/bw
